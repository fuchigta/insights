#!/bin/sh
# コミット時の検査をまとめて実行する。
# 有効化: git config core.hooksPath .githooks
#
# 検査の実体・設定は spotter（spotter/、insights とは別の Go module）に集約されている。
# 対応表・拒否ルール・許可 type 一覧などは .spotter.yml（既定の設定ファイル名）にある。
#
# 以下は `spotter install` が生成するものと同じ内容（マーカーも含めて揃えることで
# `spotter doctor` が正しく「設置済み」と認識できるようにしている）。
# --- spotter (managed) begin ---
if command -v spotter >/dev/null 2>&1; then
  spotter check --message "$1" || exit 1
else
  echo "spotter: コマンドが見つからないため検査をスキップします" >&2
fi
# --- spotter (managed) end ---
